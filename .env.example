# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Temporary downloads directory
DOWNLOAD_DIR=downloads

# Throttling interval for progress bar updates in seconds (recommended: 2.0 to avoid Telegram 429)
PROGRESS_UPDATE_INTERVAL=2.0

# Optional: Spotify API credentials (if omitted, zero-credential scraping is used)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Optional: SoundCloud client ID (if omitted, dynamic client ID harvesting is used)
SOUNDCLOUD_CLIENT_ID=

# Optional: Genius Access Token for fetching lyrics (if omitted, free LRCLIB fallback is used)
# Get a free token at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Optional: Custom FFmpeg executable path (if omitted, bundled imageio-ffmpeg or system PATH is used)
FFMPEG_PATH=

# Optional: HTTP/SOCKS5 Proxy for Telegram API and restricted providers (e.g. YouTube, SoundCloud)
# Examples: PROXY_URL=http://127.0.0.1:7890 or PROXY_URL=socks5://127.0.0.1:10808
PROXY_URL=
